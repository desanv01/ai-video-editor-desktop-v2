# ╔══════════════════════════════════════════════════════════╗
# ║  AI Video Editing Agent — Environment Configuration     ║
# ║  v2: Voxtral + DeepSeek + Hybrid n8n/LangGraph          ║
# ╚══════════════════════════════════════════════════════════╝

# ── API Keys ──
MISTRAL_API_KEY=...              # Required: Voxtral transcription (primary ASR)
DEEPSEEK_API_KEY=sk-...          # Required: LLM reasoning (Agents 2, 3, 5)
OPENAI_API_KEY=sk-...          # Required: Embeddings + Whisper (fallback ASR)
ALIBABA_API_KEY=sk-...         # Qwen (Alibaba Cloud DashScope) — Vision model API key

# ── Database ──
POSTGRES_USER=aive
POSTGRES_PASSWORD=aive_secret
POSTGRES_DB=aive_db
DATABASE_URL=postgresql+asyncpg://aive:aive_secret@db:5432/aive_db

# ── Qdrant ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Storage ──
VIDEO_STORAGE_PATH=/data/videos
UPLOAD_PATH=/data/uploads

# ── ASR Configuration ──
ASR_PROVIDER=voxtral                          # "voxtral" (primary) or "whisper" (fallback)
VOXTRAL_MODEL=voxtral-mini-latest             # Mistral transcription model
MISTRAL_BASE_URL=https://api.mistral.ai/v1
WHISPER_MODEL=whisper-1                       # OpenAI Whisper (fallback only)
ASR_LANGUAGE=en                               # Force English-biased transcription for mostly-English lectures
ASR_CONTEXT_PROMPT="English software engineering lecture with occasional Malay phrases. Object design reuse patterns, design patterns, bridge pattern, template method, class diagram, inheritance, delegation."

# ── LLM Configuration (per-agent — all swappable) ──
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT2_MODEL=deepseek-v4-flash                # Content Understanding — V4 Flash
AGENT3_MODEL=deepseek-v4-flash                # Fluency Detection — V4 Flash (or qwen3-8b)
AGENT5_MODEL=deepseek-v4-pro                  # Edit Planner — V4 Pro (strongest reasoning)

# AI Provider Settings
AI_PROCESSING_MODE=hybrid                     # "api", "local", or "hybrid"
AI_PROVIDER_FALLBACK_ENABLED=true
AI_TRANSCRIPTION_MODE=api
AI_CHAT_MODE=api
AI_EMBEDDING_MODE=api
AI_VISION_MODE=api
AI_LOCAL_RUNTIME_MODE=local
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SETTINGS_SECRET_KEY=                      # Required before storing API keys in app settings DB
LOCAL_TRANSCRIPTION_MODEL_PATH=
LOCAL_CHAT_MODEL_PATH=
LOCAL_EMBEDDING_MODEL_PATH=
LOCAL_VISION_MODEL_PATH=
LOCAL_RUNTIME_PATH=

# ── Embedding Configuration ──
EMBEDDING_MODEL=text-embedding-3-small        # OpenAI (swap to BGE-M3 endpoint when available)
EMBEDDING_DIMENSIONS=1536

# ── Context Biasing (improve ASR accuracy on domain terms) ──
DOMAIN_TERMS=["algorithm","polymorphism","quicksort","binary tree","recursion"]

# ── Processing ──
MAX_VIDEO_SIZE_MB=500
FRAME_SAMPLE_INTERVAL=1.0
SILENCE_THRESHOLD_DB=-40
SILENCE_MIN_DURATION=1.5
MIN_EDIT_REDUCTION_PERCENT=18
MAX_AUTO_CUT_IMPORTANCE=0.62


# ── App ──
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:1420","http://127.0.0.1:1420","tauri://localhost"]
BACKEND_MEMORY_LIMIT=6g
