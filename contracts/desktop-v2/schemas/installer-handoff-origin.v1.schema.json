{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aive.local/contracts/desktop-v2/installer-handoff-origin.v1.schema.json",
  "title": "Desktop Installer Handoff Origin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffRoot",
    "catalogRelativePath",
    "componentsRelativePath"
  ],
  "properties": {
    "schemaVersion": {
      "const": "desktop.installer-handoff-origin.v1"
    },
    "handoffRoot": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32767
    },
    "catalogRelativePath": {
      "const": "Catalog/offline-catalog.json"
    },
    "componentsRelativePath": {
      "const": "Components"
    }
  }
}
