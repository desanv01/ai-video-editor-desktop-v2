{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "AI Video Editor Desktop V2",
  "version": "2.0.0-rc.2",
  "identifier": "com.fyp.ai-video-editor.desktop-v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Video Editor Desktop V2",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*; media-src 'self' http://localhost:* http://127.0.0.1:* blob:; img-src 'self' http://localhost:* http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "AI Video Editor Desktop V2",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "resources": ["resources/lecturer-handoff"]
  },
  "plugins": {
  }
}
