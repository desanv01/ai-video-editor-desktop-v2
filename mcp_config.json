{
  "mcpServers": {
    "ai-video-editor-video-tools": {
      "command": "python",
      "args": ["backend/app/mcp/run_mcp.py", "video_tools"],
      "cwd": "/path/to/ai-video-editor",
      "env": {
        "PYTHONPATH": "backend/app"
      }
    },
    "ai-video-editor-knowledge-tools": {
      "command": "python",
      "args": ["backend/app/mcp/run_mcp.py", "knowledge_tools"],
      "cwd": "/path/to/ai-video-editor",
      "env": {
        "PYTHONPATH": "backend/app",
        "OPENAI_API_KEY": "your-openai-key",
        "QDRANT_HOST": "localhost",
        "QDRANT_PORT": "6333"
      }
    },
    "ai-video-editor-pipeline-tools": {
      "command": "python",
      "args": ["backend/app/mcp/run_mcp.py", "pipeline_tools"],
      "cwd": "/path/to/ai-video-editor",
      "env": {
        "PYTHONPATH": "backend/app",
        "DATABASE_URL": "postgresql+asyncpg://aive:aive_password@localhost:5432/aive_db",
        "OPENAI_API_KEY": "your-openai-key",
        "DEEPSEEK_API_KEY": "your-deepseek-key",
        "MISTRAL_API_KEY": "your-mistral-key",
        "QDRANT_HOST": "localhost",
        "QDRANT_PORT": "6333"
      }
    }
  }
}
