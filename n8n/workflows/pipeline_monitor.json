{
  "name": "AI Video Editor — Processing Pipeline Monitor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-uploaded",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-trigger",
      "name": "Video Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "video-uploaded"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://backend:8000/api/v1/videos/{{ $json.video_id }}/status",
        "options": {}
      },
      "id": "check-status",
      "name": "Check Processing Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-complete",
              "leftValue": "={{ $json.status }}",
              "rightValue": "awaiting_review",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-ready",
      "name": "Is Ready for Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-failed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-failed",
      "name": "Is Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 520]
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "id": "wait-poll",
      "name": "Wait 15 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [480, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://backend:8000/api/v1/videos/{{ $('Video Upload Webhook').item.json.video_id }}/report",
        "options": {}
      },
      "id": "get-report",
      "name": "Get Quality Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "notify-success",
              "name": "message",
              "value": "=✅ Video processing complete!\n\nOriginal: {{ $json.original_duration_seconds }}s\nEstimated: {{ $json.estimated_duration_seconds }}s\nReduction: {{ $json.reduction_percent }}%\nSegments: {{ $json.total_segments }}\n\nReady for teacher review in the desktop app.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-success",
      "name": "Format Success Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "notify-fail",
              "name": "message",
              "value": "=❌ Video processing FAILED!\n\nVideo: {{ $('Video Upload Webhook').item.json.video_id }}\nError: {{ $json.error_message }}\n\nPlease check the backend logs.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-failure",
      "name": "Format Failure Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 620]
    },
    {
      "parameters": {},
      "id": "end-success",
      "name": "Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1440, 200]
    },
    {
      "parameters": {},
      "id": "end-failure",
      "name": "Failure",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1200, 620]
    }
  ],
  "connections": {
    "Video Upload Webhook": {
      "main": [
        [
          { "node": "Check Processing Status", "type": "main", "index": 0 }
        ]
      ]
    },
    "Check Processing Status": {
      "main": [
        [
          { "node": "Is Ready for Review?", "type": "main", "index": 0 },
          { "node": "Is Failed?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Is Ready for Review?": {
      "main": [
        [
          { "node": "Get Quality Report", "type": "main", "index": 0 }
        ],
        [
          { "node": "Wait 15 seconds", "type": "main", "index": 0 }
        ]
      ]
    },
    "Is Failed?": {
      "main": [
        [
          { "node": "Format Failure Message", "type": "main", "index": 0 }
        ],
        [
          { "node": "Wait 15 seconds", "type": "main", "index": 0 }
        ]
      ]
    },
    "Wait 15 seconds": {
      "main": [
        [
          { "node": "Check Processing Status", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Quality Report": {
      "main": [
        [
          { "node": "Format Success Message", "type": "main", "index": 0 }
        ]
      ]
    },
    "Format Success Message": {
      "main": [
        [
          { "node": "Success", "type": "main", "index": 0 }
        ]
      ]
    },
    "Format Failure Message": {
      "main": [
        [
          { "node": "Failure", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "ai-video-editor" }
  ],
  "meta": {
    "instanceId": "aive-pipeline-monitor"
  }
}
